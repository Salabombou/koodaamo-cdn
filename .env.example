# Public hostname or IP; the generated peer endpoint uses UDP 65298.
WG_SERVERURL=
WG_PEERS=client

SAMBA_USER=samba
SAMBA_PASSWORD=

# Mount the SSD first, then create shared/ on it. Do not use a host-disk fallback.
SSD_PATH=/mnt/external-ssd/shared
# Set these to the owner/group IDs of the share directory.
PUID=1000
PGID=1000
